// Added DISPARITY_DETECTED and RECONCILIATION_RUN enum values for automated audit reporting
enum AuditAction {
  SOFT_DELETE
  RESTORE
  ACCOUNT_FREEZE
  MANUAL_REVERSAL
  DEBT_OVERRIDE
  DISPARITY_DETECTED   // Logged when calculated ledger sum !== stored wallet balance
  RECONCILIATION_RUN   // Logged when an admin manually triggers a full system audit
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String      // ID of the user/admin or 'SYSTEM' performing the action
  role       UserRole    // Role of the entity performing the action
  action     AuditAction // Specific type of administrative operation executed
  resource   String      // Target table/entity (e.g., 'Product', 'Wallet')
  resourceId String      // Target record unique identifier
  ipAddress  String?     // Client IP address captured during the request
  metadata   Json?       // JSON snapshot of state changes before/after operation
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
}