enum WalletStatus {
  ACTIVE
  FROZEN
  RESTRICTED
}

enum TransactionType {
  CREDIT
  DEBIT
  REVERSAL_CREDIT
  REVERSAL_DEBIT
}

// User roles for Role-Based Access Control (RBAC)
enum UserRole {
  ADMIN
  USER
  SYSTEM
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      UserRole  @default(USER) // User access level definition
  wallet    Wallet?
  orders    Order[]
  createdAt DateTime  @default(now())

  // Soft deletion timestamp for user identity lifecycle preservation
  deletedAt DateTime?

  @@index([email])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id])
  balance      Decimal             @default(0.00) @db.Decimal(12, 2)
  status       WalletStatus        @default(ACTIVE)
  transactions WalletTransaction[]
  updatedAt    DateTime            @updatedAt

  // Soft deletion timestamp for wallet preservation
  deletedAt    DateTime?
}

model WalletTransaction {
  id             String          @id @default(uuid())
  walletId       String
  wallet         Wallet          @relation(fields: [walletId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
  type           TransactionType
  description    String
  idempotencyKey String?
  
  senderName     String?
  receiverName   String?

  createdAt      DateTime        @default(now())

  // NOTE: WalletTransaction deliberately does NOT have deletedAt to maintain an immutable audit trail
  @@index([walletId, createdAt])
  @@index([idempotencyKey])
}