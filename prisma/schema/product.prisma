model Product {
  id         String      @id @default(uuid())
  title      String
  stock      Int
  price      Decimal     @db.Decimal(10, 2)
  metadata   Json
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  // GIN Index for JSONB Metadata
  @@index([metadata(ops: JsonbPathOps)], type: Gin, name: "idx_product_metadata_gin")

  // B-Tree Index for Numerical Range Filtering & Sorting
  @@index([price], name: "idx_product_price_btree")
}