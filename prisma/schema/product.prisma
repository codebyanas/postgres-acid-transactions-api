model Product {
  id         String      @id @default(uuid())
  title      String
  stock      Int
  price      Decimal     @db.Decimal(10, 2)
  metadata   Json
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  // PostgreSQL GIN Index for JSONB metadata column optimization
  // Uses JsonbPathOps operator class to accelerate `@>` containment queries for dynamic nested filtering
  @@index([metadata(ops: JsonbPathOps)], type: Gin, name: "idx_product_metadata_gin")
}